# Copy to .env and fill in. .env is gitignored -- it holds two sets of database
# credentials and must never be committed.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)

# --- The punching machines (SQL Server, on the factory LAN) -----------------
# Reachable only from inside the plant. That is the whole reason this script
# exists and runs here rather than on the application server.
ATTENDANCE_DB_HOST=192.168.1.xxx
ATTENDANCE_DB_PORT=1433
ATTENDANCE_DB_NAME=Biometrics
ATTENDANCE_DB_USER=
ATTENDANCE_DB_PASSWORD=

# Which punch table is live. Three of the four in that database are archives
# that simply stopped being written to, and pointing at one is SILENT -- every
# employee reads as absent. Change only with a MAX(CombinedDatetime) in hand.
ATTENDANCE_PUNCH_TABLE=punchtransfer

# --- The factory database (Postgres, the Django application's own) ----------
# Use a role that may only SELECT and INSERT on the three attendance_punch*
# tables. Not the postgres superuser: this box sits on the factory floor, and
# the only thing standing between it and the rest of the database is this line.
PG_HOST=
PG_PORT=5432
PG_NAME=factory
PG_USER=attendance_sync
PG_PASSWORD=
